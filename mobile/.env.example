# ── Backend API (obrigatório para teste em dispositivo físico) ──
# URL base do backend SEM o sufixo /api
#
# Exemplos por ambiente:
#   Expo Web / iOS Simulator:     http://localhost:3333
#   Android Emulator:             http://10.0.2.2:3333
#   Celular físico (mesma Wi-Fi): http://SEU_IP_LAN:3333
#
# Descubra seu IP no Windows: ipconfig
# O backend escuta na porta 3333 (npm run dev na raiz do projeto)
EXPO_PUBLIC_API_ORIGIN=http://SEU_IP_LAN:3333

# Porta da API (opcional — padrão 3333, usada nos fallbacks automáticos)
# EXPO_PUBLIC_API_PORT=3333

# ── Android nativo (react-native-maps) ──
# Necessário apenas para build Android standalone com mapas nativos.
# Não é usado pelo Leaflet do frontend web.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
